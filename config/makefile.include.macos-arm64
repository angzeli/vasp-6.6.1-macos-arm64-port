# Independently written configuration after inspecting the 6.6.1 GNU template.
# MPI CPU build; no OpenMP, GPU, HDF5, qd, Libxc or external plugins.
# Versions come from scripts/environment.sh (config/toolchain-defaults.txt,
# overridden by the host-local private/toolchain.env); build via scripts/build.sh.
ifndef PORT_GCC_VERSION
$(error PORT_*_VERSION unset: build with scripts/build.sh, which sources scripts/environment.sh)
endif
GNU_ROOT = /opt/homebrew/Cellar/gcc/$(PORT_GCC_VERSION)
MPI_ROOT = /opt/homebrew/Cellar/open-mpi/$(PORT_OPENMPI_VERSION)
OPENBLAS_ROOT = /opt/homebrew/Cellar/openblas/$(PORT_OPENBLAS_VERSION)
SCALAPACK_ROOT = /opt/homebrew/Cellar/scalapack/$(PORT_SCALAPACK_VERSION)
FFTW_ROOT = /opt/homebrew/Cellar/fftw/$(PORT_FFTW_VERSION)
GCC_MAJOR = $(firstword $(subst ., ,$(PORT_GCC_VERSION)))

export OMPI_FC = $(GNU_ROOT)/bin/gfortran
export OMPI_CC = $(GNU_ROOT)/bin/gcc-$(GCC_MAJOR)
export OMPI_CXX = $(GNU_ROOT)/bin/g++-$(GCC_MAJOR)

CPP_OPTIONS = -DHOST=\"DarwinARM64GNU\" -DMPI -DMPI_BLOCK=8000 \
              -Duse_collective -DscaLAPACK -DCACHE_SIZE=4000 \
              -Davoidalloc -Dvasp6 -Dtbdyn -Dfock_dblbuf
CPP = $(GNU_ROOT)/bin/gcc-$(GCC_MAJOR) -E -C $*$(FUFFIX) >$*$(SUFFIX) $(CPP_OPTIONS)
FC = $(MPI_ROOT)/bin/mpifort
FCL = $(FC)
FREE = -ffree-form -ffree-line-length-none
FFLAGS = -ffpe-summary=none -fallow-argument-mismatch
OFLAG = -O2
OFLAG_IN = $(OFLAG)
DEBUG = -O0

CPP_LIB = $(CPP)
FC_LIB = $(FC)
CC_LIB = $(GNU_ROOT)/bin/gcc-$(GCC_MAJOR)
CFLAGS_LIB = -O
FFLAGS_LIB = -O1
FREE_LIB = $(FREE)
OBJECTS_LIB = linpack_double.o
CXX_PARS = $(GNU_ROOT)/bin/g++-$(GCC_MAJOR)

LLIBS = -lstdc++ -L$(SCALAPACK_ROOT)/lib -lscalapack \
        -L$(OPENBLAS_ROOT)/lib -lopenblas -L$(FFTW_ROOT)/lib -lfftw3
INCS = -I$(FFTW_ROOT)/include
